# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files by default, but re-include the tracked
# per-environment terraform.tfvars files (dev/uat/prod) - they only hold
# non-secret sizing/config values. Anything else (local overrides, secrets)
# should use *.auto.tfvars.local instead, which stays ignored.
*.tfvars
*.tfvars.json
!dev/terraform.tfvars
!uat/terraform.tfvars
!prod/terraform.tfvars
*.auto.tfvars.local

# Backend config files contain storage account/subscription details -
# keep only the .example templates in git.
backend.hcl
*.backend.hcl
!*.hcl.example

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Saved plan files (terraform plan -out=tfplan) are CI artifacts, not
# committed - see .github/workflows/terraform-plan-apply.yml
tfplan
*.tfplan
tfplan.timestamp

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Optional: ignore graph output files generated by `terraform graph`
# *.dot

# Optional: ignore plan files saved before destroying Terraform configuration
# Uncomment the line below if you want to ignore planout files.
# planout